[Unit]
Description=Wi-Fi Survey server
Documentation=https://github.com/<OWNER>/wifi-survey
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
# the venv lives outside the unit so upgrades can replace it atomically
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=WIFISURVEY_CONFIG=@CONFIG@
Environment=WIFISURVEY_DATA_DIR=@DATA_DIR@
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# the config holds the viewer token; only the service account may read it
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
ReadOnlyPaths=@CONFIG@
# needed for the LAN interface and, on hosts with UniFi, outbound HTTPS
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
